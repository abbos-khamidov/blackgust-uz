# Public site URL (canonical, hreflang, sitemap, OG). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://blackgust.uz

# Extra origins allowed to POST /api/lead (comma-separated).
# In production only NEXT_PUBLIC_SITE_URL is allowed; add e.g. https://www.blackgust.uz or
# http://localhost:3000 when you test `npm run build && npm start` locally.
ALLOWED_ORIGINS=

# ---- Lead delivery: configure at least one channel ----
# Telegram: create a bot via @BotFather, add it to a group, get the chat id (e.g. via @userinfobot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email via Resend (https://resend.com). The FROM domain must be verified in Resend.
RESEND_API_KEY=
LEAD_EMAIL_TO=hello@blackgust.uz
LEAD_EMAIL_FROM=BlackGust <leads@blackgust.uz>

# ---- Optional: Cloudflare Turnstile (invisible captcha) ----
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
